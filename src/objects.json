  {"name":"Weather Balloon","slug":"weather-balloon","logR":1.875061,"logM":3.145862,"rho":0.000791752885,"cat":"macro","subcat":"machine","z":4,"aliases":["atmospheric balloon launch","weather balloons launch","radiosonde launch","HAB-600 launch"],"wiki":"Weather_balloon","paper":{"label":"Kaymont HAB-600","sub":"600 g envelope; 19.8 ft burst diameter","url":"https://www.kaymont.com/product-page/hab-600"},"_note":"Representative HAB-600 MODEL at launch: measured 600 g envelope; assumed 500 g payload/rigging and 1.5 m spherical launch fill (helium at 15 C, 101325 Pa). Same enclosed gas and total mass at launch and near 19.8 ft burst diameter; no venting. Size excludes long suspension line. Volume and gas mass derived; actual burst size varies."},
  {"name":"Weather Balloon (near burst)","slug":"weather-balloon-near-burst","logR":2.47965,"logM":3.145862,"rho":0.0000121569036,"cat":"macro","subcat":"machine","z":4,"aliases":["atmospheric balloon near burst","weather balloons near burst","radiosonde near burst","HAB-600 near burst"],"wiki":"Weather_balloon","paper":{"label":"Kaymont HAB-600","sub":"600 g envelope; 19.8 ft burst diameter","url":"https://www.kaymont.com/product-page/hab-600"},"_note":"Representative HAB-600 MODEL at near burst: measured 600 g envelope; assumed 500 g payload/rigging and 1.5 m spherical launch fill (helium at 15 C, 101325 Pa). Same enclosed gas and total mass at launch and near 19.8 ft burst diameter; no venting. Size excludes long suspension line. Volume and gas mass derived; actual burst size varies."},
  {"name":"Hot-air Balloon","slug":"hot-air-balloon","logR":2.93886,"logM":6.410938,"rho":0.00117379328,"cat":"macro","subcat":"machine","z":4,"aliases":["hot air balloon","hot air balloons","Cameron A-77"],"wiki":"Hot_air_balloon","paper":{"label":"Cameron A-Type","sub":"A-77 envelope dimensions and volume","url":"https://cameronballoons.com/a-type/"},"_note":"Representative loaded MODEL using Cameron A-77 envelope: 77500 ft3, 57 ft high. Assumed 500 kg envelope/basket/burner/fuel/occupants plus enclosed air at 100 C, sea-level pressure; total about 2.58 t. NOT the manufacturer certified lifting weight. Height refers to envelope; basket/rigging excluded from size. rho uses inflated gas volume."},
  {"name":"Zeppelin NT","slug":"zeppelin-nt","logR":3.574031,"logM":6.905796,"rho":0.000955489614,"cat":"macro","subcat":"machine","z":4,"aliases":["airship","airships","dirigible","Zeppelin N07-101"],"wiki":"Zeppelin_NT","paper":{"label":"Zeppelin NT technical data","sub":"Operator specifications","url":"https://zeppelinflug.de/en/zeppelin-nt/technik"},"_note":"Operator lists 75 m length, 8425 m3 envelope volume and 8050 kg maximum takeoff weight. Uses published aviation weight convention: source does not separately identify lifting-gas mass, so no speculative gas correction added. Bulk rho approximates listed mass / envelope volume; gondola volume omitted."},
  {"name":"Soap Bubble","slug":"soap-bubble","logR":0.176091,"logM":-1.695823,"rho":0.001425,"cat":"macro","subcat":"machine","z":4,"aliases":["soap bubbles","bubble"],"wiki":"Soap_bubble","_note":"Representative MODEL: 3 cm diameter, assumed 1 micrometre water-density film, enclosed dry air at 15 C and 101325 Pa (1.225 kg/m3). Mass includes air (~17.3 mg) plus film (~2.83 mg), not film only. Film thickness varies during drainage."},
