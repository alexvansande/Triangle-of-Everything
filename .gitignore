node_modules/
dist/
.DS_Store
*.local
.env
.env.*
!.env.example
.vite/
background/

# Claude Code session workspaces (per-session git worktrees and tool state)
.claude/

# Perf reports are run artifacts (CI uploads its own); only the baseline stays tracked
scripts/perf-reports/*
!scripts/perf-reports/mobile-perf-2026-08-19T17-40-31-993Z.json
# Reference material dropped into scripts/ (e.g. stray PDFs)
scripts/**/*.pdf

# Raw catalogue downloads for the dust layer (re-fetched by npm run build:dust)
scripts/dust/.cache/

# Poster renders (scripts/poster.mjs output)
posters/

# Narration media: recordings and renders stay local (they get re-recorded).
# The one exception is the reference cut in video/reference/, kept so each
# new version can be compared against it and then replace it.
*.m4a
*.wav
*.mp3
*.flac
*.mp4
!video/reference/*.mp4
.narr-render-*/
