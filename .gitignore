node_modules/
dist/
dist-preview
.DS_Store
*.local
.env
.env.*
!.env.example
.vite/
background/

# Claude Code session workspaces (per-session git worktrees and tool state)
.claude/

# Perf reports are run artifacts (CI uploads its own); only the baseline stays tracked
scripts/perf-reports/*
!scripts/perf-reports/mobile-perf-2026-08-19T17-40-31-993Z.json
# Reference material dropped into scripts/ (e.g. stray PDFs)
scripts/**/*.pdf

# Raw catalogue downloads for the dust layer (re-fetched by npm run build:dust)
scripts/dust/.cache/

# Poster renders (scripts/poster.mjs output)
posters/

# Narration media: recordings and renders live outside git (iCloud).
*.m4a
*.wav
*.mp3
*.flac
*.mp4
# The exceptions: the shorts' audio and mix, so they play out of the box
!public/narration/short-*/audio.m4a
!public/narration/short-*/mix.m4a
.narr-render-*/
__pycache__/
narration-frames/

# rendered videos (local only; copies go to iCloud)
output/
